# Email Configuration - PRODUCTION READY
# This configuration uses Gmail SMTP for real email delivery
# IMPORTANT: You must enable 2FA on your Gmail account and create an App Password

# SMTP Host
EMAIL_HOST=smtp.gmail.com

# SMTP Port (587 for TLS, 465 for SSL)
EMAIL_PORT=587

# Secure connection (false for TLS on port 587, true for SSL on port 465)
EMAIL_SECURE=false

# Your Gmail address
EMAIL_USER=nyuydinecedric@gmail.com

# Gmail App Password (NOT your regular password)
# Generate this from: https://myaccount.google.com/apppasswords
EMAIL_PASS=rzhkqmxffclutcmb

# From email address (usually same as EMAIL_USER)
EMAIL_FROM=noreply@unibamenda.cm

