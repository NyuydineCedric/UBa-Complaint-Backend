# Email Configuration
# To enable email notifications when complaint status changes, configure these variables:

# SMTP Host (e.g., smtp.gmail.com)
EMAIL_HOST=smtp.gmail.com

# SMTP Port (usually 587 for TLS or 465 for SSL)
EMAIL_PORT=587

# Set to "true" if using SSL/TLS on port 465
EMAIL_SECURE=false

# Email account username/sender address
EMAIL_USER=your-email@gmail.com

# Email account password or app-specific password
EMAIL_PASS=your-app-password

# From email address (optional, defaults to EMAIL_USER)
EMAIL_FROM=noreply@uba-complaints.com

# EXAMPLE: Gmail Configuration
# 1. Enable 2-factor authentication on your Gmail account
# 2. Generate an "App Password" from https://myaccount.google.com/apppasswords
# 3. Use that App Password as EMAIL_PASS
# 4. EMAIL_USER=your-email@gmail.com
# 5. EMAIL_HOST=smtp.gmail.com
# 6. EMAIL_PORT=587
# 7. EMAIL_SECURE=false
